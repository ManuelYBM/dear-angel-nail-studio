# Copia este archivo como .env.public y completa los valores vacíos.
# Nunca confirmes .env.public ni compartas sus secretos por chat.

NODE_ENV=production
TZ=America/Merida
NEXT_PUBLIC_API_URL=/api/backend
PUBLIC_APP_URL=
CORS_ORIGIN=

POSTGRES_DB=dear_angel
POSTGRES_USER=dear_angel
POSTGRES_PASSWORD=
# Codifica caracteres especiales de la contraseña para usarlos dentro de la URL.
DATABASE_URL=

MINIO_ROOT_USER=dear_angel
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=dear-angel-private

SESSION_COOKIE_NAME=da_session
SESSION_TTL_DAYS=30
OTP_PEPPER=
OTP_MOCK_DEBUG_ENABLED=false
WHATSAPP_DEVELOPMENT_TEXT_OTP_RECIPIENTS=
INTEGRATION_ENCRYPTION_KEY=

BACKGROUND_JOBS_MODE=worker
WORKER_SHARED_SECRET=

ADMIN_FULL_NAME=Administradora Dear Angel
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_INITIAL_PASSWORD=

# WhatsApp es necesario para alta/verificación y recuperación de clientas.
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=cloud
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v26.0
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
# Plantillas AUTHENTICATION aprobadas con botón OTP "Copiar código".
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_PASSWORD_RESET=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_APPOINTMENT_UPDATE=
WHATSAPP_TEMPLATE_QUOTE_UPDATE=
WHATSAPP_TEMPLATE_PAYMENT_UPDATE=
WHATSAPP_TEMPLATE_COUPON_UNLOCKED=

# SMTP es necesario para recuperación de administradora y manicuristas.
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Dear Angel Nail Studio

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

BACKUP_INTERVAL_SECONDS=604800
BACKUP_RETRY_SECONDS=300
BACKUP_RETENTION_DAYS=90
BACKUP_HEALTH_GRACE_SECONDS=3600

# Opcional: enlace estable de ngrok.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
