# Runtime
NODE_ENV=development
TZ=America/Merida

# Public endpoints
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001/api
NEXT_PUBLIC_API_URL=/api/backend
CORS_ORIGIN=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# Permanent development link with a free ngrok account
# Copy both values from the ngrok dashboard. Never commit the real token.
NGROK_AUTHTOKEN=
NGROK_DOMAIN=your-assigned-domain.ngrok-free.app
# When sharing the app, change PUBLIC_APP_URL to https:// plus this domain.

# Weekly PostgreSQL + MinIO backups
BACKUP_INTERVAL_SECONDS=604800
BACKUP_RETENTION_DAYS=90

# Optional, only for an explicit local demonstration seed
DEMO_DATA_ENABLED=false
DEMO_INITIAL_PASSWORD=DearAngelDemo2026

# Sessions and one-time codes
SESSION_COOKIE_NAME=da_session
SESSION_TTL_DAYS=30
OTP_PEPPER=replace_with_a_long_random_value

# PostgreSQL
POSTGRES_DB=dear_angel
POSTGRES_USER=dear_angel
POSTGRES_PASSWORD=dear_angel_local_password
DATABASE_URL=postgresql://dear_angel:dear_angel_local_password@postgres:5432/dear_angel?schema=public

# Redis
REDIS_URL=redis://redis:6379

# S3-compatible storage (MinIO locally)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=dear_angel
MINIO_ROOT_PASSWORD=dear_angel_minio_password
MINIO_BUCKET=dear-angel-private

# WhatsApp Cloud API: keep disabled until Meta credentials are ready
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_TEMPLATE_LANGUAGE=es_MX
WHATSAPP_TEMPLATE_OTP=
WHATSAPP_TEMPLATE_PASSWORD_RESET=
WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=
WHATSAPP_TEMPLATE_APPOINTMENT_UPDATE=
WHATSAPP_TEMPLATE_QUOTE_UPDATE=
WHATSAPP_TEMPLATE_PAYMENT_UPDATE=
WHATSAPP_TEMPLATE_COUPON_UNLOCKED=

# SMTP for staff recovery
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=miniyahirpro@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=Dear Angel Nail Studio

# Google Calendar
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/google-calendar/callback
INTEGRATION_ENCRYPTION_KEY=

# Initial administrator (used in the identity phase)
ADMIN_FULL_NAME=Administradora Dear Angel
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_INITIAL_PASSWORD=
